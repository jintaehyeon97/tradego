# 관세청 무역통계 API 인증키 (data.go.kr 에서 발급받은 본인 키로 교체)
API_KEY=your_data_go_kr_api_key_here

# Flask 세션 암호화 키 (랜덤 문자열로 교체: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_secret_key

# PostgreSQL 연결 정보 (본인 환경에 맞게 수정)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/tradego
